{
  "name": "gatana",
  "version": "3.0.0",
  "description": "Javascript/Typescript SDK for Gatana",
  "homepage": "https://github.com/gatana-ai/gatana-js#readme",
  "bugs": {
    "url": "https://github.com/gatana-ai/gatana-js/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gatana-ai/gatana-js.git"
  },
  "license": "MIT",
  "author": "",
  "type": "module",
  "files": [
    "dist"
  ],
  "bin": {
    "gatana": "./dist/bin/gatana.mjs"
  },
  "main": "./dist/index.mjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "test": "npx tsx --test 'test/**/*.test.ts'",
    "generate": "npx tsx gensdk.ts",
    "build": "tsdown --format esm --format cjs",
    "dev": "tsdown --watch",
    "release": "tsdown --format esm --format cjs && np --no-tests"
  },
  "dependencies": {
    "@inquirer/prompts": "^7.8.6",
    "@types/eventsource": "^1.1.15",
    "@types/lodash": "^4.17.20",
    "archiver": "^7.0.1",
    "chalk": "^5.6.2",
    "commander": "^14.0.1",
    "console-table-printer": "^2.14.6",
    "debug": "^4.4.1",
    "eventsource": "^4.0.0",
    "js-yaml": "^4.1.1",
    "lodash": "^4.17.21",
    "open": "^10.2.0",
    "openid-client": "^6.8.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@hey-api/openapi-ts": "0.82.5",
    "@jest/globals": "^29.7.0",
    "@tsconfig/recommended": "^1.0.10",
    "@types/archiver": "^6.0.3",
    "@types/debug": "^4.1.12",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^24.3.1",
    "msw": "^2.11.2",
    "node-mock-extended": "^1.0.0",
    "np": "^11.0.2",
    "prettier": "^3.6.2",
    "tsdown": "^0.21.0-beta.2",
    "tsx": "^4.21.0",
    "typescript": "^5.9.2"
  }
}
