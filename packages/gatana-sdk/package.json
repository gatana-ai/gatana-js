{
  "name": "gatana-sdk",
  "version": "2.3.3",
  "description": "Javascript/Typescript SDK for Gatana",
  "homepage": "https://github.com/gatana-ai/gatana-js#readme",
  "bugs": {
    "url": "https://github.com/gatana-ai/gatana-js/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gatana-ai/gatana-js.git",
    "directory": "packages/gatana-sdk"
  },
  "license": "MIT",
  "type": "module",
  "files": [
    "dist"
  ],
  "main": "./dist/index.mjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./api": {
      "import": {
        "types": "./dist/api/index.d.mts",
        "default": "./dist/api/index.mjs"
      },
      "require": {
        "types": "./dist/api/index.d.cts",
        "default": "./dist/api/index.cjs"
      }
    },
    "./apiv2": {
      "import": {
        "types": "./dist/apiv2/index.d.mts",
        "default": "./dist/apiv2/index.mjs"
      },
      "require": {
        "types": "./dist/apiv2/index.d.cts",
        "default": "./dist/apiv2/index.cjs"
      }
    },
    "./config": {
      "import": {
        "types": "./dist/config.d.mts",
        "default": "./dist/config.mjs"
      },
      "require": {
        "types": "./dist/config.d.cts",
        "default": "./dist/config.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "NODE_OPTIONS=--max-old-space-size=8192 tsdown --format esm --format cjs",
    "dev": "tsdown --watch",
    "test": "npx tsx --test 'test/**/*.test.ts'",
    "generate": "npx tsx gensdk.ts"
  },
  "dependencies": {
    "@types/eventsource": "^1.1.15",
    "@types/lodash": "^4.17.20",
    "debug": "^4.4.1",
    "eventsource": "^4.0.0",
    "lodash": "^4.17.21",
    "openid-client": "^6.8.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@hey-api/openapi-ts": "0.96.0",
    "@tsconfig/recommended": "^1.0.10",
    "@types/debug": "^4.1.12",
    "@types/node": "^24.3.1",
    "tsdown": "^0.21.0-beta.2",
    "tsx": "^4.21.0",
    "typescript": "^5.9.2"
  }
}
